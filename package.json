    "lighthouse:ci": "npm run build && node scripts/resolve-audit-urls.mjs && lhci autorun"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.16.1",
    "@tailwindcss/typography": "^0.5.13",

# ============================================================
# Terméktesztek - ÉLES környezet minta (.env.example)
# Másold le .env néven a szerveren, és töltsd ki a saját értékeiddel.
# Ezt a fájlt TILOS kitöltve gitre tenni!
# ============================================================

# SQLite - maradhat így (prisma/dev.db a repó mellett, gitignore-olt)
DATABASE_URL="file:./dev.db"

# Session titok - generáld: openssl rand -base64 48
JWT_SECRET="IDE-ILLESZD-BE-A-GENERALT-TITKOT"

# Éles admin fiók (a seed hozza létre az első deploy-nál).
# FIGYELEM: a deploy-script shellként olvassa a .env-t, ezért a jelszóban
# kerüld a $ és ` karaktereket (az openssl-es titok base64-e ilyeneket nem tartalmaz).
ADMIN_EMAIL="admin@termektesztek.com"
ADMIN_PASSWORD="IDE-EROS-JELSZOT"
ADMIN_NAME="Szerkesztő"

# Publikus oldal (SEO, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL="https://termektesztek.com"
NEXT_PUBLIC_SITE_NAME="Terméktesztek és vélemények"
NEXT_PUBLIC_SITE_DESCRIPTION="Alapos, független terméktesztek és vásárlási tanácsok."

# Google Analytics 4 mérési azonosító (Consent Mode: csak engedély után mér)
NEXT_PUBLIC_GA_ID="G-XXXXXXX"

# === ÉLES MÓD: a háttér-workerek (szinkron, link-ellenőrzés) TILTVA ===
# A szinkront az itthoni gépen futtatod, az eredményt push-scripttel
# vagy a "Push to live" admin gombbal töltöd fel.
WORKERS_DISABLED=true

# === Az alábbiak élesen NEM kellenek (csak itthoni gépre) ===
# GEMINI_API_KEYS, GEMINI_MODEL, GEMINI_MAX_RPM/RPD,
# PUPPETEER_EXECUTABLE_PATH, ALLEGRO_PROFILE_DIR,
# ALLEGRO_AFFILIATE_PARAMS (ez a cikkekben mentett linkekben már benne van),
# PUSH_TO/PUSH_EMAIL/PUSH_PASSWORD (ezek az ITTHONI .env-be kellenek!)

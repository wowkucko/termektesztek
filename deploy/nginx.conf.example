# Nginx reverse proxy pelda a termektesztelo bloghoz.
# Masold pl. ide: /etc/nginx/sites-available/termektesztelo
# majd linkeld: sudo ln -s /etc/nginx/sites-available/termektesztelo /etc/nginx/sites-enabled/
#
# Csereld le a "peldablog.hu" domaint a sajatodra, majd futtasd:
#   sudo certbot --nginx -d peldablog.hu -d www.peldablog.hu
# (a Certbot ezutan automatikusan kiegesziti ezt a fajlt a HTTPS beallitasokkal)

server {
    listen 80;
    server_name peldablog.hu www.peldablog.hu;

    # Kepfeltoltesek: a admin upload vegpont max. 8 MB-os fajlokat fogad el,
    # ezert az Nginx limitet is ennel kicsit nagyobbra allitjuk.
    client_max_body_size 10M;

    location /uploads/ {
        alias /var/www/termektesztelo/public/uploads/;
        expires 30d;
        access_log off;
    }

    location /_next/static/ {
        alias /var/www/termektesztelo/.next/static/;
        expires 365d;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
